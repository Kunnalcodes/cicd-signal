{
  "name": "signal-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=@signal/web",
    "dev:api": "npm run dev --workspace=@signal/api",
    "dev:worker": "npm run dev --workspace=@signal/worker",
    "build": "npm run build --workspaces --if-present",
    "build:packages": "npm run build --workspace=@signal/shared --workspace=@signal/database --workspace=@signal/scanner-rules",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2"
  }
}
